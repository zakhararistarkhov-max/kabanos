# Copy to .env and adjust. docker-compose reads this automatically.
# The built-in defaults are fine for local development.

# --- app ---
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000

# --- ports (host side) ---
FRONTEND_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_UI_PORT=8025

# --- postgres ---
POSTGRES_USER=kabanos
POSTGRES_PASSWORD=kabanos
POSTGRES_DB=kabanos
# Only used by docker-compose.scale.yml (streaming replication):
POSTGRES_REPLICATION_PASSWORD=replicator

# --- auth ---
# MUST be a strong, random value (>=32 chars) in production. Generate with:
#   openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me

# --- email (transactional) ---
# By default mail is captured by the bundled Mailpit (view at http://localhost:8025)
# and does NOT reach real inboxes. To deliver to real email, uncomment and fill a
# real SMTP provider below, then `docker compose up -d api worker`.
MAIL_FROM_NAME=Kabanos
MAIL_FROM_EMAIL=no-reply@kabanos.local
#
# SMTP_TLS: leave empty to auto-detect from the port (465 -> tls, 587 -> starttls,
# anything else -> plaintext). Override with none|starttls|tls if needed.
#
# Gmail (needs an App Password, not your normal password):
#   https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_TLS=starttls
# MAIL_FROM_EMAIL=you@gmail.com
#
# mail.ru (needs a "password for external apps"):
#   https://account.mail.ru/user/2-step-auth/passwords/
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USERNAME=you@mail.ru
# SMTP_PASSWORD=your-app-password
# SMTP_TLS=tls
# MAIL_FROM_EMAIL=you@mail.ru

# --- object storage (MinIO) for dish photos ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY=kabanos
S3_SECRET_KEY=kabanos-secret
S3_BUCKET=kabanos
# What the BROWSER uses to reach MinIO (presigned URLs are signed for this host).
S3_PUBLIC_ENDPOINT=localhost:9000

# --- telegram (optional, for the morning digest bot; added in a later slice) ---
TELEGRAM_BOT_TOKEN=
